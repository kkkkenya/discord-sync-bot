# Copy this file to .env (same folder) and fill it in. Never commit .env or paste these values anywhere public.

# Discord Developer Portal → your app (the same one Vercel uses) → Bot → Reset Token.
# After resetting, put the new token in Vercel too (Settings → Environment Variables → DISCORD_TOKEN).
DISCORD_TOKEN=

# Supabase → Project Settings → API. Use the service_role key (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# console.anthropic.com → API keys. Used only for the daily practice problem.
ANTHROPIC_API_KEY=

# Folders to watch, separated by ; (a PC folder and your Google Drive for Desktop folder).
# Point at the hub's folders, not your whole Drive.
WATCH_DIRS=C:\Users\grego\Documents\Hub Uploads;G:\My Drive\Engineering Study Hub

# Files at least this big (MB), or PDFs with at least BOOK_PAGES pages, are treated as books.
BOOK_MB=15
BOOK_PAGES=150
