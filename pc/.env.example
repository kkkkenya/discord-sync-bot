# Copy this file to .env (same folder) and fill it in. Never commit .env or paste these values anywhere public.

# Discord Developer Portal → your app (the same one Vercel uses) → Bot → Reset Token.
# After resetting, put the new token in Vercel too (Settings → Environment Variables → DISCORD_TOKEN).
DISCORD_TOKEN=

# Supabase → Project Settings → API Keys. Use the secret key (sb_secret_..., or the legacy service_role key),
# not the publishable one: the publishable key can't read or write the bot's tables.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# console.anthropic.com → API keys. Only needed when daily problems are on (FEATURES in lib/config.js).
ANTHROPIC_API_KEY=

# Folders to watch, separated by ;  Drive shortcuts (.lnk) inside them are followed, so a folder of
# shortcuts to shared course folders works. Point at the hub's folders, not your whole Drive or the bot's code.
WATCH_DIRS=G:\My Drive\Notes , past papers , etc
# Folder names to leave out wherever they appear, separated by ;
SKIP_FOLDERS=

# Files at least this big (MB), or PDFs with at least BOOK_PAGES pages, are treated as books.
BOOK_MB=15
BOOK_PAGES=150
