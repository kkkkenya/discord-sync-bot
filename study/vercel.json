{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/auth/:action",
      "destination": "/api/router?auth=:action"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "crux_session"
        }
      ],
      "destination": "https://www.engineeringhub.site/crux/",
      "permanent": false
    }
  ]
}
