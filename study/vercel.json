{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/auth/:action",
      "destination": "/api/router?auth=:action"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 23 * * *"
    }
  ]
}
