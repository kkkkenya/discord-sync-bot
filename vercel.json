{
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/daily.js": {
      "maxDuration": 300
    },
    "api/study.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard/",
      "permanent": false
    }
  ]
}
